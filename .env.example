BASE_URL=http://192.168.0.XXX:9000
AUDIO_MOUNT=/mnt/truenas/podcasts/pivot
# "small" is ~3x faster than "medium" on CPU and plenty accurate for ad detection
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# CPU threads Whisper may use inside the container (keep below CPU_LIMIT)
WHISPER_CPU_THREADS=2

# Container resource caps so transcription can't starve the host (SSH etc.)
CPU_LIMIT=2
MEM_LIMIT=4g
POLL_INTERVAL_HOURS=1
AD_BUFFER_SECONDS=3.0
AD_MIN_GAP_SECONDS=30.0
AD_RESUME_WINDOW_SECONDS=90.0
SECRET_KEY=changeme-in-production

# Only download episodes newer than this many days (0 = no limit)
MAX_EPISODE_AGE_DAYS=30
# Delete published episodes this many days after they are cut (0 = keep forever)
RETENTION_DAYS=30

# --- LLM ad detection ---
# Provider: "anthropic" (Haiku via API), "none" (regex only). Falls back to
# regex automatically if the API key is missing or a call fails.
LLM_PROVIDER=anthropic
# Pay-as-you-go Anthropic API key (console.anthropic.com). Leave blank to use regex.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Timezone for the 5-8am fast-poll release window (Pivot drops on Eastern time)
SCHEDULE_TZ=America/New_York

# Auto-cut and publish as soon as an episode is transcribed (still editable after)
AUTO_PUBLISH=true
